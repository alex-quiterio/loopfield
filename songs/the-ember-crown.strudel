// THE EMBER CROWN — epic hybrid · 140 bpm · C minor
// Banners on the ridge, a crown of fire on the horizon, and no road back.
setcpm(140/4)

stack(
  // war drums from the start, a distorted 909 joins at bar 9
  note("[c2 ~ c2 c2] [~ c2 ~ c2] [c2 c2 ~ c2] [~ c2 c2 c2]").s("gm_taiko_drum").room(.5).gain(.8),
  note("~ ~ c3 ~").s("gm_timpani").gain(.7),
  s("bd ~ ~ ~ ~ ~ bd ~ ~ ~ bd ~ ~ ~ ~ ~").bank("RolandTR909").distort(.8).gain(.8)
    .mask("<0!8 1!8>"),
  s("~ ~ ~ ~ cp ~ ~ ~ ~ ~ ~ ~ cp ~ ~ ~").bank("RolandTR909").room(.8).gain(.4)
    .mask("<0!8 1!8>"),

  // the string ostinato that drives the charge: i, VI, iv, VII
  n("0 0 2 0 3 0 2 0 0 0 2 0 4 3 2 1".add("<0 -2 -4 -1>")).scale("C3:minor")
    .s("gm_string_ensemble_1").clip(.7).gain(.45),
  n("<0 -2 -4 -1>").struct("x ~ ~ x ~ ~ x ~").scale("C2:minor")
    .s("gm_cello").gain(.6),

  // the horns call from bar 5
  n("<[0 ~ ~ 2] [5@3 4] [3 ~ ~ 2] [-1@3 ~]>").scale("C4:minor")
    .s("gm_french_horn").attack(.05).release(.8).room(.7).gain(.6)
    .mask("<0!4 1!12>"),

  // the choir rises with the crown
  n("<[0,2,4] [-2,0,2] [-4,-2,0] [-1,1,3]>").scale("C4:minor")
    .s("gm_choir_aahs").attack(.3).release(1.5).room(.9).gain(.4)
    .mask("<0!8 1!8>"),

  // fire: a pulsing supersaw whose filter climbs every 8 bars
  n("[0,4]*8").scale("C3:minor").s("supersaw")
    .decay(.1).sustain(.3).lpf(saw.range(300, 5000).slow(8)).gain(.15),
)
