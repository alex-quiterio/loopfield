// POYEKHALI — hazy tape electronica · 88 bpm · D major
// 108 minutes around the Earth, and the first human to see all of it at once says only: let's go.
// 132 bars · 6:00
setcpm(88/4)

// --- harmony: Dmaj7, Bm7, Gmaj7, Em7, two bars each ---------------------------
const chords = "<[d3,f#3,a3,c#4] [b2,d3,f#3,a3] [g2,b2,d3,f#3] [e2,g2,b2,d3]>/2"
const roots = "<d2 b1 g1 e2>/2"
const warble = perlin.range(-.18, .18).slow(3) // old tape, drifting off pitch

// --- the instruments ---------------------------------------------------------
const tape = stack(
  s("crackle").gain(.07),
  s("pink").hpf(3500).gain(.025),
)
const pad = note(chords).add(note(warble)).s("sawtooth")
  .attack(1.2).release(2.5).lpf(1100).room(.9).roomsize(6).gain(.12)
const warm = note(chords).s("gm_pad_warm").attack(1).release(2).room(.8).gain(.32)
const count = s("numbers").n("<~ ~ ~ ~ [8 ~ 7 ~] [6 ~ 5 ~] [4 ~ 3 ~] [2 ~ 1 ~] 0 ~ ~ ~ ~ ~ ~ ~>")
  .speed(.85).lpf(2600).crush(10).room(.7).delay(.45).delaytime(3/8).delayfeedback(.4).gain(.75)
const radio = s("space").n("<0 3 7 11>").slow(2).speed(.6).room(1).gain(.22)
const rumble = note("d1").s("sawtooth").lpf(sine.range(80, 420).slow(12)).gain(.35)

const kick = s("bd ~ ~ ~ ~ ~ bd ~ ~ bd ~ ~ ~ ~ ~ ~").bank("RolandTR808").lpf(900).crush(10).gain(.9)
const snare = s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~").bank("LinnDrum").lpf(3200).room(.45).gain(.5)
const hats = s("[~ hh]*4").bank("LinnDrum").lpf(6000).gain(.18)
const bass = note(roots).struct("x ~ ~ ~ ~ ~ x ~ ~ x ~ ~ ~ ~ ~ ~")
  .s("triangle").lpf(600).release(.3).gain(.55)

// a melody you could hum from a window seat
const theme = note("<[f#4@3 e4] [d4@2 a3 ~] [d4@3 c#4] [b3@4] [d4@3 e4] [f#4@2 a4 ~] [g4@2 f#4 e4] [d4@4]>")
const lead = theme.add(note(warble)).s("sawtooth").lpf(1600).attack(.08).release(.8)
  .room(.8).delay(.45).delaytime(3/8).delayfeedback(.45).gain(.16)
const stars = note(chords).add(note(24)).arp("0 1 2 3 2 1 3 2")
  .s("gm_music_box").delay(.4).delaytime(3/16).delayfeedback(.4).room(.6).gain(.2)
const earth = note(chords).s("gm_choir_aahs").attack(1).release(2).room(1).gain(.24)

// --- the flight ----------------------------------------------------------------
arrange(
  [16, stack(tape, pad.lpf(600), count, radio)],                         // countdown
  [12, stack(tape, pad, warm, rumble, bass.gain(.35))],                  // ignition
  [32, stack(tape, kick, snare, hats, bass, pad, warm, stars)],          // ascent
  [24, stack(tape, pad, warm, lead, earth, stars.degradeBy(.4))],        // weightless
  [32, stack(tape, kick, snare, hats, bass, pad, warm, lead, earth, stars)], // the whole Earth, at once
  [16, stack(tape, pad.lpf(500), radio, lead.degradeBy(.5).gain(.1),
             s("numbers").n("<0 ~ 1 ~ 2 ~ 3 ~ ~ ~ ~ ~ ~ ~ ~ ~>").speed(.8).room(.9).gain(.5))], // re-entry
)
