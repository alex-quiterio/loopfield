// POLAR NIGHT STATION — arctic ambient · 72 bpm · E dorian
// Seventy degrees north. The sun left in November. The instruments are still listening.
setcpm(72/4)

stack(
  // wind across the antenna field
  s("wind").n("<0 3 6 9>").slow(4).speed(.5).lpf(2500)
    .room(1).roomsize(10).gain(.35),

  // the ice sheet: a glacial pad that barely moves, and a faint saw under it
  n("<[0,4,9] [-2,2,7] [0,3,9] [-3,2,6]>/4").scale("E2:dorian")
    .s("gm_pad_warm").attack(3).release(6).lpf(1400)
    .room(1).roomsize(10).gain(.45),
  n("<[0,4,9] [-2,2,7] [0,3,9] [-3,2,6]>/4").scale("E3:dorian")
    .s("sawtooth").attack(4).release(6).lpf(sine.range(300, 900).slow(32))
    .room(1).gain(.08),

  // a muffled pulse from somewhere under the floor, from bar 5
  s("bd ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ ~ ~").bank("RolandTR808").lpf(300).room(.5).gain(.85)
    .mask("<0!4 1!28>"),
  s("~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [~ hh] ~ ~ ~").bank("RolandTR808").hpf(5000)
    .room(.9).delay(.6).delaytime(3/8).delayfeedback(.6).gain(.18),

  // a melodic fragment looping until it turns into landscape, from bar 9
  n("[4 ~ 3 ~ ~ ~ 1 ~] [~ ~ 0 ~ ~ ~ ~ ~]").scale("E4:dorian")
    .s("gm_vibraphone").room(1).roomsize(8)
    .delay(.5).delaytime(3/8).delayfeedback(.55).gain(.35)
    .mask("<0!8 1!24>"),

  // the station radio: a numbers voice, half lost in static
  s("numbers").n("<0 ~ ~ 3 ~ ~ 7 ~>").slow(2).speed(.8)
    .hpf(400).lpf(3000).crush(8).degradeBy(.5)
    .room(.9).delay(.5).delaytime(3/8).delayfeedback(.5).gain(.3),
  s("crackle").gain(.12).hpf(2000),

  // the deep cold
  note("e1").slow(4).s("sine").attack(4).release(6).gain(.4),
)
